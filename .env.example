# ── AI Assistant ────────────────────────────────────────────────
# Preferred: Supabase Edge Function (secure — no AI key in the browser).
# Deploy with:  supabase functions deploy ai-chat --no-verify-jwt
# Set the AI_API_KEY secret in Supabase → Edge Functions → Secrets.
# Frontend only needs VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY below.

# Optional legacy backend endpoint (backend / serverless, not a key).
# The frontend ONLY talks to this endpoint — never directly to an AI provider.
# Example: https://your-domain.com/api/ai-chat
VITE_AI_API_URL=

# When no backend is configured (VITE_AI_API_URL empty AND Supabase env
# empty), the chatbot falls back to the built-in knowledge base
# (src/data/chatKnowledge.js) — works without any key.

# ── Supabase (backend for auth, careers, applications and AI chat) ──
# Only the anon/public key belongs in the browser. Service-role keys
# must stay in your backend or Supabase server-side config only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Run supabase/schema.sql in your project SQL editor to create
# chat_sessions + chat_messages tables.
# Run database/supabase-schema.sql for employees/jobs/applications.